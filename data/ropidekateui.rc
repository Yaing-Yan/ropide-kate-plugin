<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE kpartgui SYSTEM "kpartgui.dtd">
<gui name="ropidekate" library="ropidekate" version="1">
  <MenuBar>
    <Menu name="ropide" noMerge="1">
      <text>&amp;RopIDE</text>
      <Action name="ropide_new"/>
      <Action name="ropide_open"/>
      <Separator/>
